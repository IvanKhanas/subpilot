# =============================================================================
# tg-bot-service
# =============================================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_TIMEOUT=30
TELEGRAM_POLLING_RETRY_DELAY_MS=5000
TELEGRAM_BOT_SERVER_PORT=1991

TG_BOT_GRPC_SERVER_PORT=9081

CHAT_GRPC_ADDRESS=localhost:9090
SUBSCRIPTION_GRPC_ADDRESS=localhost:9091
PAYMENT_GRPC_ADDRESS=localhost:9094
LOYALTY_GRPC_ADDRESS=localhost:9095

SUPPORT_OPERATOR_TAG=unknown
NAVIGATION_STACK_TTL=PT20M
MODERATION_CHAT_ID=0

# =============================================================================
# chat-service
# =============================================================================

OPENAI_API_KEY=
OPENAI_MAX_COMPLETION_TOKENS=2048

CHAT_SERVER_PORT=8082
CHAT_GRPC_SERVER_PORT=9090
TG_BOT_GRPC_ADDRESS=localhost:9081

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

CHAT_HISTORY_MAX_MESSAGES=20
CHAT_HISTORY_TTL=PT20M

# =============================================================================
# subscription-service
# =============================================================================

SUBSCRIPTION_DB_URL=jdbc:postgresql://localhost:5432/subscription
SUBSCRIPTION_DB_NAME=subscription
SUBSCRIPTION_DB_USER=subscription
SUBSCRIPTION_DB_PASSWORD=subscription

SUBSCRIPTION_SERVER_PORT=8083
SUBSCRIPTION_GRPC_SERVER_PORT=9091

SUBSCRIPTION_FREE_QUOTA=10
SUBSCRIPTION_FREE_QUOTA_RESET_PERIOD=7d
SUBSCRIPTION_DEFAULT_MODEL=gpt-4o-mini

# =============================================================================
# payment-service
# =============================================================================

PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/payment
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=payment

PAYMENT_SERVER_PORT=8084
PAYMENT_GRPC_SERVER_PORT=9094
PAYMENT_GRPC_ADDRESS=localhost:9094

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/subpilot

# =============================================================================
# loyalty-service
# =============================================================================

LOYALTY_DB_URL=jdbc:postgresql://localhost:5432/loyalty
LOYALTY_DB_NAME=loyalty
LOYALTY_DB_USER=loyalty
LOYALTY_DB_PASSWORD=loyalty

LOYALTY_SERVER_PORT=8085
LOYALTY_GRPC_SERVER_PORT=9095
LOYALTY_GRPC_ADDRESS=localhost:9095

LOYALTY_CASHBACK_RATE=0.10

# =============================================================================
# admin-service
# =============================================================================

ADMIN_DB_URL=jdbc:postgresql://localhost:5432/admin
ADMIN_DB_USER=admin
ADMIN_DB_PASSWORD=admin

ADMIN_SERVER_PORT=8086

ADMIN_JWT_SECRET=

ADMIN_AUTH_JWT_SECRET=
ADMIN_AUTH_JWT_ISSUER=subpilot-admin
ADMIN_AUTH_JWT_AUDIENCE=subpilot-api
ADMIN_AUTH_ACCESS_TTL_SECONDS=900
ADMIN_AUTH_REFRESH_TTL_SECONDS=1209600

ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_SCOPES=admin.read admin.write

# =============================================================================
# gateway-service
# =============================================================================

GATEWAY_SERVER_PORT=8088
ADMIN_SERVICE_BASE_URL=http://admin-service:8086
GATEWAY_INTERNAL_JWT_TTL_SECONDS=60

# =============================================================================
# Shared gRPC/Kafka
# =============================================================================

GRPC_RETRY_MAX_ATTEMPTS=3
GRPC_RETRY_INITIAL_BACKOFF_MS=200
GRPC_RETRY_BACKOFF_MULTIPLIER=3.0

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# =============================================================================
# Nginx
# =============================================================================

NGINX_SERVER_NAME=example.com

# =============================================================================
# Observability
# =============================================================================

GRAFANA_ADMIN_PASSWORD=admin
